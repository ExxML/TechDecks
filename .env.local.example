# TechDeck environment variables
# Copy to .env.local and fill in real values. .env.local is gitignored.
# This file is committed — placeholders only, never real values.
#
# RULE: any variable named NEXT_PUBLIC_* is inlined into the browser bundle
# at build time and is readable by anyone. Everything else is server-only.

# ---------------------------------------------------------------------------
# Supabase — required
# ---------------------------------------------------------------------------

# CLIENT-SAFE. Your project's API URL.
# Supabase dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# CLIENT-SAFE BY DESIGN. The public key. Ships in the browser bundle.
# It is only safe because RLS is enabled on every table — see SETUP.md section 2.
# Supabase dashboard -> Project Settings -> API -> anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# NOT CLIENT-SAFE. BYPASSES ROW LEVEL SECURITY ENTIRELY.
# Anyone holding this can read, modify, or delete every row, including other
# users' data. Used ONLY by scripts/seed.ts and the GitHub Actions sync job.
#   - never rename it with a NEXT_PUBLIC_ prefix
#   - never import it into a component, hook, or anything a client component reaches
#   - never set it in the Vercel dashboard (see SETUP.md section 6)
# It lives in exactly two places: this local file, and GitHub Actions secrets.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------------------------------------------------------------------------
# App — required
# ---------------------------------------------------------------------------

# CLIENT-SAFE. Origin of this deployment. Used for OAuth redirects and for the
# same-origin check on /api/gemini/*. Set to the real Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Manual sync trigger — OPTIONAL. Omit unless /api/sync/leetcode is built.
# These three go in Vercel, not in GitHub Actions. See SETUP.md section 7.3.
# ---------------------------------------------------------------------------

# NOT client-safe. GitHub fine-grained PAT, scoped to this repo,
# Actions: read and write. Used to dispatch the sync workflow.
# GH_DISPATCH_TOKEN=

# NOT client-safe. Target repository as owner/repo.
# GH_REPO=your-github-username/TechDeck

# NOT client-safe. Any long random string. Bearer token the route requires
# before it will dispatch the workflow.
# SYNC_TRIGGER_SECRET=

# ---------------------------------------------------------------------------
# Gemini: intentionally absent.
# Each user enters their own key at runtime. It is never an env var.
# ---------------------------------------------------------------------------
